AMO_BASE_URL=https://your-account.amocrm.ru
# Recommended for a private, single-account installation:
AMO_LONG_LIVED_TOKEN=replace_me

# OAuth alternative (leave commented when using a long-lived token):
# AMO_CLIENT_ID=replace_me
# AMO_CLIENT_SECRET=replace_me
# AMO_REDIRECT_URI=https://example.invalid/amocrm/oauth/callback
AMO_TOKEN_FILE=/data/amocrm-tokens.json
HOST=0.0.0.0
PORT=3000
